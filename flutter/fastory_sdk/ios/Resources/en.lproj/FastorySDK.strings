/* The error view's message when the surface could not be loaded for a reason other than the connection. */
"error.generic" = "Something went wrong.";

/* The error view's message when nothing answered: no connection, DNS failure, timeout. */
"error.noConnection" = "No internet connection.";

/* The error view's primary action. */
"action.retry" = "Retry";

/* The game sheet's way out of the error view, and the hub's close affordance for a screen reader. */
"action.close" = "Close";

/* The loading indicator's label while the hub or a game is being fetched — what a screen reader says when Retry is pressed. */
"status.loading" = "Loading…";

/* Announced when the page Retry waited for has loaded. */
"status.loaded" = "Content loaded.";
