{
  "$comment": "Shared bridge-envelope truth table for the SDK v1 postMessage bridge (strategy doc: envelope frozen as {v, type, payload}; v1 transport = URL interception, v2+ = postMessage). Every case is since=v1: platforms load this file and SKIP each case until the bridge parser ships (FASTORY-2552), then flip the flag feature-side to enter the red-green loop. Contract invariants encoded here: strict integer version match, unknown types are ignored (allow-list model), malformed input never throws, payload is optional and must be an object when present. decision values: accept | ignore.",
  "schemaVersion": 1,
  "envelopeVersion": 1,
  "cases": [
    {
      "name": "well-formed envelope with a known type is accepted",
      "since": "v1",
      "message": "{\"v\":1,\"type\":\"fastory:ready\",\"payload\":{}}",
      "knownTypes": ["fastory:ready"],
      "decision": "accept"
    },
    {
      "name": "well-formed envelope without a payload is accepted",
      "since": "v1",
      "message": "{\"v\":1,\"type\":\"fastory:ready\"}",
      "knownTypes": ["fastory:ready"],
      "decision": "accept"
    },
    {
      "name": "unknown type is ignored even when the envelope is valid",
      "since": "v1",
      "message": "{\"v\":1,\"type\":\"fastory:launch-missiles\",\"payload\":{}}",
      "knownTypes": ["fastory:ready"],
      "decision": "ignore"
    },
    {
      "name": "higher envelope version is ignored",
      "since": "v1",
      "message": "{\"v\":2,\"type\":\"fastory:ready\",\"payload\":{}}",
      "knownTypes": ["fastory:ready"],
      "decision": "ignore"
    },
    {
      "name": "missing version field is ignored",
      "since": "v1",
      "message": "{\"type\":\"fastory:ready\",\"payload\":{}}",
      "knownTypes": ["fastory:ready"],
      "decision": "ignore"
    },
    {
      "name": "string version is ignored (strict integer match)",
      "since": "v1",
      "message": "{\"v\":\"1\",\"type\":\"fastory:ready\",\"payload\":{}}",
      "knownTypes": ["fastory:ready"],
      "decision": "ignore"
    },
    {
      "name": "non-string type is ignored",
      "since": "v1",
      "message": "{\"v\":1,\"type\":42,\"payload\":{}}",
      "knownTypes": ["fastory:ready"],
      "decision": "ignore"
    },
    {
      "name": "non-object payload is ignored",
      "since": "v1",
      "message": "{\"v\":1,\"type\":\"fastory:ready\",\"payload\":\"boom\"}",
      "knownTypes": ["fastory:ready"],
      "decision": "ignore"
    },
    {
      "name": "malformed json is ignored without throwing",
      "since": "v1",
      "message": "{\"v\":1,\"type\":",
      "knownTypes": ["fastory:ready"],
      "decision": "ignore"
    },
    {
      "name": "top-level array is ignored",
      "since": "v1",
      "message": "[{\"v\":1,\"type\":\"fastory:ready\"}]",
      "knownTypes": ["fastory:ready"],
      "decision": "ignore"
    },
    {
      "name": "empty known-type list ignores every message",
      "since": "v1",
      "message": "{\"v\":1,\"type\":\"fastory:ready\",\"payload\":{}}",
      "knownTypes": [],
      "decision": "ignore"
    }
  ]
}
